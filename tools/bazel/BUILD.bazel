package(default_visibility = ["//visibility:public"])

# The rbe-ubuntu24-04 index TL3 pins: these are its amd64 and arm64 manifests.
platform(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        "@bazel_tools//tools/cpp:gcc",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:5f0c01e5f6d79e58d7a996330de33aa38ce599bf8431eaf27521e7602daadf50",
        # Hermetic by default; tests in nonhermetic.bzl opt back in.
        "dockerNetwork": "off",
        "dockerUser": "1000:1000",
    },
)

platform(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        "@bazel_tools//tools/cpp:gcc",
    ],
    exec_properties = {
        "Arch": "arm64",
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:2f48fc6c0c7f0794a76c74d77ff23b1a80944e05acacff22c63da2ef002ebf9b",
        "dockerNetwork": "off",
        "dockerUser": "1000:1000",
    },
)

exports_files(["npm_test.sh"])

filegroup(
    name = "sources",
    srcs = glob(["*.bzl", "*.sh"]) + ["BUILD.bazel"],
)
